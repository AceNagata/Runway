rules_version = '2';

/* Runway — Firestore security rules.
 *
 * An organisation is a document at /orgs/{slug} with everything under it. Membership is a
 * document keyed by the signed-in user's Firebase uid, which is what every rule below turns
 * on: if there is no member document for you under this org, you get nothing.
 *
 * What these rules DO enforce:
 *   - You must be signed in and a member of that org to read any of its work.
 *   - Private notes stay private. Only the owner reads an unshared note.
 *   - Notifications are readable only by the person they are addressed to.
 *   - Only an admin edits membership, sections, or the org itself.
 *   - Joining requires the org's join code, and you can never make yourself an admin.
 *
 * What they DO NOT enforce, and this is deliberate for v1:
 *   §4's "a user can see the tasks of anyone below them, and cannot see sideways or upward"
 *   is a graph traversal, and rules cannot walk a tree. Tasks are therefore readable by any
 *   member of the org, and the subtree rule is applied in the client. A determined member
 *   could read a task outside their subtree by calling the API directly.
 *
 *   Hardening that means denormalising the visible set onto each task — a `visibleTo` array
 *   holding the owner's manager chain plus the originator — and matching on it here:
 *       allow read: if request.auth.uid in resource.data.visibleTo;
 *   It is cheap to write and expensive to retrofit, but it also has to be recomputed for
 *   every affected task whenever the reporting tree changes, so it is called out in
 *   DECISIONS.md rather than half-done.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /* ---------------------------------------------------------------- Runway platform

       Above the organisations sits Runway itself. A platform admin issues the invite codes
       that let somebody create an organisation, and can see and close accounts.

       Bootstrapping is deliberately done in the Firebase console rather than in the app:
       create a document at platformAdmins/{your-uid}. Any "first person to claim it wins"
       rule would be a race on a public URL, and any bootstrap secret would have to live
       somewhere — in this file, in the repository, or in a chat log. The console is the one
       place that already proves who owns the project. */

    function isPlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    match /platformAdmins/{uid} {
      // You may check whether you are one; a list is admins-only.
      allow get: if signedIn() && (request.auth.uid == uid || isPlatformAdmin());
      allow list: if isPlatformAdmin();
      // Never self-granted. Either the console, or an existing platform admin.
      allow create, update, delete: if isPlatformAdmin();
    }

    /* An invitation to create one organisation. The code is the document id, so claiming it
       is a single-document write — which is what makes two people racing the same code safe:
       Firestore commits one and the other's rule then sees it already taken. */
    match /orgInvites/{code} {
      allow get: if signedIn();
      allow list: if isPlatformAdmin();
      allow create, delete: if isPlatformAdmin();

      /* The claim names both the account and the address, in one write, once.
         The address matters: org creation below asks only whether the invite is yours, and
         that stays true forever, so without pinning an address one code would mint
         organisations without limit. `usedBy == null` closes the branch after the first
         claim, which is also why the address cannot be edited afterwards. */
      allow update: if
        // A platform admin revoking or annotating it.
        isPlatformAdmin()
        // Or the one-time claim: unused, not revoked, claimed as yourself, for one address.
        || (signedIn()
            && resource.data.usedBy == null
            && resource.data.revoked == false
            && request.resource.data.usedBy == request.auth.uid
            && request.resource.data.orgSlug is string
            && request.resource.data.code == resource.data.code
            && request.resource.data.revoked == false);
    }

    function invite(code) {
      return get(/databases/$(database)/documents/orgInvites/$(code)).data;
    }

    function isMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    function isAdmin(orgId) {
      return isMember(orgId)
        && get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.admin == true;
    }

    function isOwner(orgId) {
      return signedIn()
        && get(/databases/$(database)/documents/orgs/$(orgId)).data.ownerUid == request.auth.uid;
    }

    function joinCode(orgId) {
      // get() inside a rule is not itself subject to read rules, which is how the code can be
      // checked without ever being readable by someone outside the org.
      return get(/databases/$(database)/documents/orgs/$(orgId)/private/config).data.joinCode;
    }

    match /orgs/{orgId} {
      // Name and slug only — enough to render "Join Arena Erbil" before you are a member.
      // Listable only by Runway staff, so customers cannot be enumerated by anyone else.
      allow get: if signedIn();
      allow list: if isPlatformAdmin();
      /* Creating an organisation is not open. Either you are Runway staff, or you hold an
         invite code you have already claimed *for this address* — which is why the claim
         happens first and this only has to check that it names you and names this org. */
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug == orgId
        && (
          isPlatformAdmin()
          || (
            request.resource.data.inviteCode is string
            && invite(request.resource.data.inviteCode).usedBy == request.auth.uid
            && invite(request.resource.data.inviteCode).orgSlug == orgId
            && invite(request.resource.data.inviteCode).revoked == false
          )
        );
      allow update: if isAdmin(orgId) || isPlatformAdmin();
      allow delete: if false;

      /* The join code. Readable by admins; every other check reaches it through the rules'
         own get(), above.

         The owner is allowed explicitly as well as via isAdmin, because when an organisation
         is first created the code and the owner's member document are written together — and
         rules evaluate against the state *before* the batch, where no member document exists
         yet. Without this the very first write of a new org is denied. */
      match /private/{document} {
        allow read, write: if isAdmin(orgId) || isOwner(orgId);
      }

      match /members/{memberId} {
        allow read: if isMember(orgId);

        allow create: if signedIn()
          && memberId == request.auth.uid
          && (
            // The owner bootstrapping their own organisation.
            isOwner(orgId)
            // Or somebody joining with the code — never as an admin.
            || (request.resource.data.joinedWith == joinCode(orgId)
                && request.resource.data.admin == false)
          );

        // Admins edit anyone. You may edit yourself, but cannot promote yourself.
        allow update: if isAdmin(orgId)
          || (isMember(orgId)
              && memberId == request.auth.uid
              && request.resource.data.admin == resource.data.admin);

        allow delete: if isAdmin(orgId);
      }

      match /sections/{id} {
        allow read: if isMember(orgId);
        allow write: if isAdmin(orgId);
      }

      match /folders/{id} {
        allow read, write: if isMember(orgId);
      }

      /* Org-wide read: see the note above on why the subtree rule lives in the client. */
      match /tasks/{id} {
        allow read, write: if isMember(orgId);
      }

      /* "Free-form documents owned by a user, optionally shared with the team." §2.1
         An unshared note is readable by its owner and nobody else. */
      match /notes/{id} {
        allow read: if isMember(orgId)
          && (resource.data.shared == true || resource.data.ownerId == request.auth.uid);
        allow create: if isMember(orgId) && request.resource.data.ownerId == request.auth.uid;
        allow update, delete: if isMember(orgId) && resource.data.ownerId == request.auth.uid;
      }

      /* Read-state is per user, so a notification is only ever readable by its recipient.
         Anyone in the org may raise one, because hand-off and completion both notify. */
      match /notifications/{id} {
        allow read: if isMember(orgId) && resource.data.forUserId == request.auth.uid;
        allow create: if isMember(orgId);
        allow update, delete: if isMember(orgId) && resource.data.forUserId == request.auth.uid;
      }
    }
  }
}
