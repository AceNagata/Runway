{
  "name": "runway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Runway \u2014 a shared planning surface for small teams: notes, tasks, scheduling, hand-off, reports.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/stamp-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "lucide-react": "0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.5"
  }
}
